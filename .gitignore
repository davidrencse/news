# Local Python environment
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]

# Generated SQLite index and runtime files
search-index/*.db
search-index/*.db-shm
search-index/*.db-wal

# Atomic-write scratch files
*.tmp
.tmp-bulk-100k/
.tmp-telegram-retirement.json
.tmp-remote-live.py
.tmp-selftest-storage.log

# Your library: articles, PDFs, reading history, highlights and the search index.
# Personal data and other people's copyrighted articles — never commit these.
Medium-Library/
notes/
search-index/
Papers/
data-location.txt

# Local editor/launch config, which carries absolute paths from your machine
.claude/launch.json

# Runtime log from the bundled Chromium/launcher; machine-specific noise
debug.log

# Impeccable design-tool scratch (working notes and build state)
.impeccable/
