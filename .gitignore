# Local Python environment
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]

# Generated SQLite index and runtime files
search-index/*.db
search-index/*.db-shm
search-index/*.db-wal

# Atomic-write scratch files
*.tmp

# Your library: articles, PDFs, reading history, highlights and the search index.
# Personal data and other people's copyrighted articles — never commit these.
Medium-Library/
notes/
search-index/
data-location.txt

# Local editor/launch config, which carries absolute paths from your machine
.claude/launch.json
